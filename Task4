public class task4 {
    public static void main(String[] args) {
        
        // ---- My Name ----
        String name = "lawrence";
        String reversedName = new StringBuilder(name).reverse().toString();
        
        System.out.println("Input Name: " + name);
        System.out.println("Reversed Name: " + reversedName);
        
        if (name.equals(reversedName)) {
            System.out.println("The input string is a palindrome.\n");
        } else {
            System.out.println("The input string is not a palindrome.\n");
        }

        // ---- My Dog's Name ----
        String dogName = "fenty";
        String reversedDogName = new StringBuilder(dogName).reverse().toString();
        
        System.out.println("Input Dog Name: " + dogName);
        System.out.println("Reversed Dog Name: " + reversedDogName);
        
        if (dogName.equals(reversedDogName)) {
            System.out.println("The input string is a palindrome.");
        } else {
            System.out.println("The input string is not a palindrome.");
        }
    }
}
